# MiniCopilot server configuration.
# Copy to .env and fill in ONE of the API keys (or leave both blank to use the
# built-in offline heuristic translator for a keyless demo).

# --- LLM provider (optional) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=            # optional: any OpenAI-compatible endpoint
# LLM_MODEL=                  # optional override (default: claude-sonnet-5 / gpt-4o-mini)

# --- Server ---
PORT=4000
